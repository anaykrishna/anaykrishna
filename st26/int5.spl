//<<<<<<<<<<<<<<<<<<<<<<VARIABLE DECLERATION>>>>>>>>>>>>>>>>>>>>>
alias usp R1;
usp = SP;

alias ret_addr R2;
ret_addr = [PTBR + 2*(usp-1)/512]*512 + (usp-1)%512;

alias syscall_no R3;
syscall_no = [[PTBR + 2*(usp-5)/512]*512 + (usp-5)%512];

alias arg1 R4;
arg1 = [[PTBR + 2*(usp-4)/512]*512 + (usp-4)%512];

alias arg2 R5;
arg2 = [[PTBR + 2*(usp-3)/512]*512 + (usp-3)%512];

alias pid R6;
pid = [SYSTEM_STATUS_TABLE + 1];

//<<<<<<<<<<<<<<<<<<<<<CONTECT SWITCH>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

[PROCESS_TABLE + 16*pid + 9] = syscall_no;

[PROCESS_TABLE + 16*pid + 13] = SP;
SP = [PROCESS_TABLE + 16*pid + 11]*512 - 1;

//<<<<<<<<<<<<<<<<<<<<<FCUNTION DECL>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

if(syscall_no == 2) then		//open
	alias resource_table R7;
    resource_table = [PROCESS_TABLE + 16*pid + 11]*512 + RESOURCE_TABLE_OFFSET;

    R8 = 0;
    while(R8 < 8) do			//check for free entry in resc table
		if([resource_table + 2*R8 + 0] == -1) then
			break;
		endif;
		R8 = R8 + 1;
    endwhile;

    if(R8 >= 8) then
		[ret_addr] = -3;		//max files opened, no more sapce left
		goto return_to_user;
    endif;

    multipush(R1, R2, R3, R4, R5, R6, R7, R8);
    R1 = 3;  					//open, file_manager
    R2 = arg1;
    call FILE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7, R8);

    if(R0 == -1 || R0 == -2) then
		[ret_addr] = R0;
		goto return_to_user;
    endif;

    [resource_table + 2*R8 + 0] = FILE;
    [resource_table + 2*R8 + 1] = R0;

    [ret_addr] = R8;			//file descriptor from open call
    goto return_to_user;
endif;

if(syscall_no == 3) then		//close
	alias resource_table R7;
    resource_table = [PROCESS_TABLE + 16*pid + 11]*512 + RESOURCE_TABLE_OFFSET;

    if(arg1 < 0 || arg1 >= 8 || [R7 + 2*arg1 + 0] != FILE) then		//index validation
       [ret_addr] = -1;
       goto return_to_user;
    endif;

    alias index R8;
    index = [resource_table + 2*arg1 + 1];

    multipush(R1, R2, R3, R4, R5, R6, R7, R8);
    R1 = 4;  					//close in file manager
    R2 = index;
    call FILE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7, R8);

    [resource_table + 2*arg1 + 0] = -1;
    [resource_table + 2*arg1 + 1] = -1;

    [ret_addr] = -1;		//???????????????
    goto return_to_user;
endif;

if(syscall_no == 6) then			//seek
	alias resource_table R7;
	resource_table = [PROCESS_TABLE + 16*pid + 11]*512 + RESOURCE_TABLE_OFFSET;
	
	if(arg1 < 0 || arg1 >= 8 || [resource_table + 2*arg1 + 0] != FILE) then
       [ret_addr] = -1;
       goto return_to_user;
    endif;

    alias open_file_index R8;
    open_file_index = [resource_table + 2*arg1 + 1];

    alias inode_index R9;
    inode_index = [OPEN_FILE_TABLE + 4*open_file_index + 0];

    multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9);
    R1 = 4; 					//acquire inode
    R2 = inode_index;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9);

    if(R0 == -1) then
		[ret_addr] = -1;
		goto return_to_user;
    endif;

    alias lseek R10;
    lseek = [OPEN_FILE_TABLE + 4*open_file_index + 2];

    alias file_size R11;
    if(inode_index == INODE_ROOT) then
		file_size = 480;
    else
		file_size = [INODE_TABLE + 16*inode_index + 2];
    endif;

    if(lseek + arg2 < 0) then			//error case
        multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);
        R1 = 5;  					//release inode
        R2 = inode_index;
        R3 = pid;
        call RESOURCE_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);

        [ret_addr] = -2;
        goto return_to_user;
    endif;

    if(lseek + arg2 > file_size) then
		[OPEN_FILE_TABLE + 4*open_file_index + 2] = file_size;
    else
		[OPEN_FILE_TABLE + 4*open_file_index + 2] = lseek + arg2;
    endif;

    multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);
    R1 = 5;  //release inode
    R2 = inode_index;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11);

    [ret_addr] = 0;
    goto return_to_user;
endif;


return_to_user:
    [PROCESS_TABLE + 16*pid + 9] = 0;
    SP = usp;
    ireturn;
