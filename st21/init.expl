int main()
{
decl
    int temp, child;
    str out, file;
enddecl
begin
    while(1 == 1) do
		out = "Shell :";
		write(out);
		read(file);

		if(file == "Shutdown") then
			temp = exposcall("Shutdown");
			if(temp == -1) then
				out =  "Shutdown fail";
				write(out);
				continue;
			endif;
		else
			child = exposcall("Fork");
			if(child == -1) then
				out = "Fork Fail";
				write(out);
				continue;
			endif;

			if(child == 0) then
				temp = exposcall("Exec", file);
				if(temp == -1) then
					out = "BAD COMMAND";
					write(out);
				endif;
				temp = exposcall("Signal");
			else
				temp = exposcall("Wait", child);
			endif;
		endif;
    endwhile;
    return 0;
end
}
