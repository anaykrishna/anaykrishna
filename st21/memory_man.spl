alias ret_val R0;
alias fn R1;
alias arg R2;

if(fn == 1) then		//Get Free Page
	[SYSTEM_STATUS_TABLE + 3] = [SYSTEM_STATUS_TABLE + 3] + 1;				//increment the waitmem 
	while([SYSTEM_STATUS_TABLE + 2] == 0) do
		[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 4] = WAIT_MEM;		//set stat to waitmem
		multipush(R0, R1, R2);
		call SCHEDULER;														//Busy loop Scheduler
		multipop(R0, R1, R2);
	endwhile;

	[SYSTEM_STATUS_TABLE + 3] = [SYSTEM_STATUS_TABLE + 3] - 1;				//Decrememnt the waitmem and free mem
	[SYSTEM_STATUS_TABLE + 2] = [SYSTEM_STATUS_TABLE + 2] - 1;

	R3 = 0;
	while(R3 < MAX_MEM_PAGE) do												//Find the free page
		if([MEMORY_FREE_LIST + R3] == 0) then
			ret_val = R3;		//Page found 
			[MEMORY_FREE_LIST + R3] = 1;
			break;
		endif;
		
		R3 = R3 + 1;
	endwhile;

	return;
endif;

if(fn == 2) then		//Release Page
	[MEMORY_FREE_LIST + arg] = [MEMORY_FREE_LIST + arg] - 1;
	if([MEMORY_FREE_LIST + arg] == 0) then
		[SYSTEM_STATUS_TABLE + 2] = [SYSTEM_STATUS_TABLE + 2] + 1;
	    R3 = 1;
	    while(R3 < 16) do
			if([PROCESS_TABLE + 16 * R3 + 4] == WAIT_MEM) then 
				[PROCESS_TABLE + 16 * R3 + 4] = READY;
			endif;
			
			R3 = R3 + 1;
	    endwhile;
	endif;

	return;
endif;

if(fn == 4) then		//Release Block
	R3 = DISK_FREE_LIST + arg;		
	[R3] = [R3] - 1;	//Decrement the count
	return;
endif;

if(fn == 5) then		//Get Code Page
	R3 = 0;
	while(R3 < 16) do  	//Looping throuh all the processes
		R4 = 0;
		while(R4 < 4) do
			if([DISK_MAP_TABLE + 10*R3 + 4 + R4] == arg) then	//if found the block, and valid then 
				alias ptbr R6;									//increment mem free list and return
				ptbr = [PROCESS_TABLE + 16 * R3 + 14];
				if([ptbr + 8 + 2*R4 + 1] != "0000")	then
					R5 = MEMORY_FREE_LIST + [ptbr + 8 + 2*R4];
					[R5] = [R5] + 1;
					ret_val = [ptbr + 8 + 2*R4];
				endif;
			endif;
			R4 = R4 + 1;
		endwhile;
		R3 = R3 + 1;
	endwhile;

	//else case when the code block is not found
	multipush(R1, R2, R3);
	R1 = 1;		//Get Free Page
	call MEMORY_MANAGER;
	multipop(R1, R2, R3);

	multipush(R0, R1, R2, R3);
	R1 = 2;		//disk load
	R3 = R0;	//page number(free page from last call)
	R4 = R2;	//block no.
	R2 = [SYSTEM_STATUS_TABLE + 1];
	call DEVICE_MANAGER;
	multipop(R0, R1, R2, R3);

	breakpoint;		//assignment for printing the dmt and pt

	return;
endif;