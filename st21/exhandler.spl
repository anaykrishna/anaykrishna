[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 9] = -1;
[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 13] = SP;

SP = [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 11]*512 - 1;

backup;
multipush(EIP);

breakpoint;		//assignment for looking E reg values

if(EC != 0) then
	R1 = 3;	//write
	R2 = [SYSTEM_STATUS_TABLE + 1];
	if(EC == 1) then
		R3 = "Illegal Intrsuction";
	endif;
	
	if(EC == 2) then
		R3 = "Illegal Memory";
	endif;
	
	if(EC == 3) then
		R3 = "Arithmetic Exception";
	endif;
	
	if([PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 13] >= 10*512-1) then
	    R3 = "Ustack full";
	endif;

	call DEVICE_MANAGER;

	R1 = 3;		//exit process, will terminate this process
	R2 = [SYSTEM_STATUS_TABLE + 1];
	call PROCESS_MANAGER;

	call SCHEDULER;
endif;

if(EPN >= 4) then		//code page
	R5 = [DISK_MAP_TABLE + 10*[SYSTEM_STATUS_TABLE + 1] + EPN];
	if(R5 == -1) then		//no assigned page hence terminate
		multipush(R1, R2, R5);
		R1 = 3;		//exit process(PROCESS MANAGER)
		R2 = [SYSTEM_STATUS_TABLE + 1];
		multipop(R1, R2, R5);

		call SCHEDULER;

		return;
	endif;

	//if block mapping present
	R1 = 5;		//get code page
	R2 = R5;
	call MEMORY_MANAGER;

    [PTBR + 20*[SYSTEM_STATUS_TABLE + 1] + 2*EPN] = R0;			//shouldnt it be the ptbr of the curr process
    [PTBR + 20*[SYSTEM_STATUS_TABLE + 1] + 2*EPN + 1] = "1100";

else								//for heap pages
	multipush(R0, R1, R2);

   	R1 = 1;
   	call MOD_2;						//MEMORY_MANAGER
   	[PTBR + 4] = R0;
   	[PTBR + 5] = "1110";

   	R1 = 1;
   	call MOD_2;						//MEMORY_MANAGER
   	[PTBR + 6] = R0;
   	[PTBR + 7] = "1110";

   	multipop(R0, R1, R2);

endif;

[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 9] = 0;

multipop(EIP);
restore;

SP = [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 13];
SP = SP + 1;

[[PTBR + 2*SP/512]*512 + SP%512] = EIP;

ireturn;
