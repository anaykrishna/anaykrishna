//<<<<<<<<<<<<<<<<<<VARIABLE DECLERATIONS>>>>>>>>>>>>>>>>>>>>
alias usp R1;
usp = SP;

alias syscall_no R2;
syscall_no = [[PTBR + 2*(SP-5)/512]*512 + (SP-5)%512];

alias ret_addr R3;
ret_addr = [PTBR + 2*(SP-1)/512]*512 + (SP-1)%512;

alias arg1 R4;
arg1 =  [[PTBR + 2*(SP-4)/512]*512 + (SP-4)%512];

alias pid R5;
pid = [SYSTEM_STATUS_TABLE + 1];

alias resc_table R6;
resc_table = ([PROCESS_TABLE + 16*pid + 11] + 1)*512 - 16;

alias arg2 R7;
arg2 =  [[PTBR + 2*(SP-3)/512]*512 + (SP-3)%512];

//<<<<<<<<<<<<<<<<<<<<<CONTEXT SWITCH>>>>>>>>>>>>>>>>>>>>>>>>>

[PROCESS_TABLE + 16*pid + 13] = SP;
SP = [PROCESS_TABLE + 16*pid + 11]*512 - 1;

[PROCESS_TABLE + 16*pid + 9] = syscall_no;

//<<<<<<<<<<<<<<<<<<<<<FUNCTION DECL>>>>>>>>>>>>>>>>>>>>>>>>>>>

if(syscall_no == 19) then		//Semlock
	if(arg1 < 0 || arg1 >= 8) then			//sem_id validation
		[ret_addr] = -1;
		[PROCESS_TABLE + 16*pid + 9] = 0;
		SP = usp;
		ireturn;
	endif;

	if([resc_table + 2*arg1] != SEMAPHORE) then		//resc is not a semaphore
		[ret_addr] = -1;
		[PROCESS_TABLE + 16*pid + 9] = 0;
		SP = usp;
		ireturn;
	endif;

	alias sem_id R8;
	sem_id = [resc_table + 2*arg1 + 1];
	
	while([SEMAPHORE_TABLE + 4*sem_id] != -1) do		//busy loop for locking
		[PROCESS_TABLE + 16*pid + 4] = WAIT_SEMAPHORE;
		[PROCESS_TABLE + 16*pid + 5] = sem_id;

		multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8);
        call SCHEDULER;
        multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8);
	endwhile;

	[SEMAPHORE_TABLE + 4*sem_id] = pid;

	breakpoint;
	
	R0 = 0;
	[PROCESS_TABLE + 16*pid + 9] = 0;
	SP = usp;
	ireturn;
	
endif;

if(syscall_no == 20) then		//Semunlock
	if(arg1 < 0 || arg1 >= 8) then		//sem_id validation
		[ret_addr] = -1;
		[PROCESS_TABLE + 16*pid + 9] = 0;
		SP = usp;
		ireturn;
	endif;

	if([resc_table + 2*arg1] != SEMAPHORE) then		//resource is not a semaphore
		[ret_addr] = -1;
		[PROCESS_TABLE + 16*pid + 9] = 0;
		SP = usp;
		ireturn;
	endif;
	
	alias sem_id R8;
	sem_id = [resc_table + 2*arg1 + 1];

	if([SEMAPHORE_TABLE + 4*sem_id] != -1) then
		if([SEMAPHORE_TABLE + 4*sem_id] != pid) then	//another process trying to unlock
			[ret_addr] = -2;
			[PROCESS_TABLE + 16*pid + 9] = 0;
			SP = usp;
			ireturn;
		endif;

		[SEMAPHORE_TABLE + 4*sem_id] = -1;

		R9 = 0;
		while(R9 < 16) do
			R10 = PROCESS_TABLE + 16*R9;
			if([R10 + 4] == WAIT_SEMAPHORE && [R10 + 5] == sem_id) then
				[R10 + 4] = READY;
			endif;
			R9 = R9 + 1;
		endwhile;
		
	endif;

	[ret_addr] = 0;
	[PROCESS_TABLE + 16*pid + 9] = 0;
	SP = usp;
	ireturn;
	
endif;
