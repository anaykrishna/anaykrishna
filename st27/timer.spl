[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 13] = SP;		//Changing of Stack Pointer from usr to kernel
SP = 512 * [PROCESS_TABLE + 16 * [SYSTEM_STATUS_TABLE+1] + 11]; 

backup;

//<<<<<<<<<<<<<<<<<<<<<<<<<Stage27>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

if([SYSTEM_STATUS_TABLE + 5] != 0) then		//swapping enabled
	if([SYSTEM_STATUS_TABLE + 1] == SWAPPER_DAEMON) then
		R1 = [SYSTEM_STATUS_TABLE + 5];		//1:swapin, 2:swapout
		call PAGER_MODULE;
	endif;

else
    if([SYSTEM_STATUS_TABLE + 2] < MEM_LOW) then
        [SYSTEM_STATUS_TABLE + 5] = SWAP_OUT;
    else
    	R1 = -1;	//to store pid of one to be changed to swaped in
    	R2 = 3;		//looper
    	R4 = -1;	//flag for swap_in process

    	while(R2 < 15) do
			R3 = PROCESS_TABLE + 16*R2;
			if([R3 + 6] == 1) then		//currently in swap_in
				R4 = 1;
				if([R3 + 0] > MAX_TICK) then
					R1 = R2;
					break;
				endif;
			endif;
			
			R2 = R2 + 1;
    	endwhile;

    	if(R1 != -1 || (R4 == 1 && [SYSTEM_STATUS_TABLE + 2] > MEM_HIGH)) then
			[SYSTEM_STATUS_TABLE + 5] = SWAP_IN;
    	endif;
    endif;
endif;

//<<<<<<<<<<<<<<END OF STAGE 27>>>>>>>>>>>>>>>>>>>>>>>

[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 4] = READY;	//just before scheduler change the current process to READY

//Incrememting tick for all processes
R1 = 0;
while(R1 < 16) do
	[PROCESS_TABLE + 16*R1] = [PROCESS_TABLE + 16*R1] + 1; 
	R1 = R1 + 1;
endwhile;

call SCHEDULER;

restore;

SP = [PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE+1] + 13];
[PROCESS_TABLE + 16*[SYSTEM_STATUS_TABLE + 1] + 9] = 0;

ireturn;
