//<<<<<<<<<<<<<<<<<<VARIABLE DECLERATIONS>>>>>>>>>>>>>>>>>>>>
alias usp R1;
usp = SP;

alias syscall_no R2;
syscall_no = [[PTBR + 2*(SP-5)/512]*512 + (SP-5)%512];

alias ret_addr R3;
ret_addr = [PTBR + 2*(SP-1)/512]*512 + (SP-1)%512;

alias arg1 R4;
arg1 = [[PTBR + 2*(SP-4)/512]*512 + (SP-4)%512];

alias arg2 R6;
arg2 = [[PTBR + 2*(SP-3)/512]*512 + (SP-3)%512];

alias pid R5;
pid = [SYSTEM_STATUS_TABLE + 1];

//<<<<<<<<<<<<<<<<<<<<<CONTEXT SWITCH>>>>>>>>>>>>>>>>>>>>>>>>>
[PROCESS_TABLE + 16*pid + 9] = syscall_no;

[PROCESS_TABLE + 16*pid + 13] = SP;
SP = [PROCESS_TABLE + 16*pid + 11]*512 - 1;

//<<<<<<<<<<<<<<<<<<<<<<<<FUNC DECL>>>>>>>>>>>>>>>>>>>>>>>>>>>

if(syscall_no == 1) then		//create		??????????????is it correct checking???????????????
    R7 = 0;
    while(R7 < MAX_FILE_NUM) do
        if([INODE_TABLE + 16*R7 + 1] == 0) then
            [ret_addr] = 0;  //file already created
            goto return_to_user;
        endif;

        R7 = R7 + 1;
    endwhile;

    R7 = 0;
    while(R7 < MAX_FILE_NUM) do
        if([INODE_TABLE + 16*R7 + 1] == -1) then
            break;
        endif;
        R7 = R7 + 1;
    endwhile;

	if(R7 >= MAX_FILE_NUM) then		//if no free space return
		[ret_addr] = -1;
		goto return_to_user;
	endif;

	R8 = INODE_TABLE + 16*R7;
	[R8 + 0] = DATA;		//type
	[R8 + 1] = arg1;		//name:arg1
	[R8 + 2] = 0;			//size
	[R8 + 3] = [PROCESS_TABLE + 16*pid + 3];//current user
	[R8 + 4] = arg2;		//permission
	//5,6,7 are unused
	//8,9,10,11 the code blocks
	[R8 + 8] = -1;
	[R8 + 9] = -1;
	[R8 + 10] = -1;
	[R8 + 11] = -1;	
	//12,13,14,15 are unused

	R8 = ROOT_FILE + 8*R7;
	[R8 + 0] = arg1; 	//name
    [R8 + 1] = 0;    	//size
    [R8 + 2] = DATA; 	//type
    R10 = [PROCESS_TABLE + 16*pid + 3];  	//index to find the username
    [R8 + 3] = [USER_TABLE + 2*R10 + 0]; 	//username
    [R8 + 4] = arg2; //permission

    [ret_addr] = 0;
    goto return_to_user;
    
endif;

if(syscall_no == 4) then		//delete
	SP = [PROCESS_TABLE + 16*pid + 11]*512;

	R7 = 0;
    while(R7 < MAX_FILE_NUM) do
        if([INODE_TABLE + 16*R7 + 1] == arg1) then
            break;
        endif;
        R7 = R7 + 1;
    endwhile;

    if(R7 >= MAX_FILE_NUM) then
	    [ret_addr] = 0;  		//File not found, return with 0
	    goto return_to_user;
    endif;

    if([INODE_TABLE + 16*R7 + 0] != DATA) then
        [ret_addr] = -1;		//File not DATA type, return with -1
        goto return_to_user;
    endif;

    if([INODE_TABLE + 16*R7 + 4] == 0) then
		if(
			[SYSTEM_STATUS_TABLE + 0] != 0 		//not root
			&&
			[INODE_TABLE + 16*R7 + 3] != [SYSTEM_STATUS_TABLE + 0]	//not owner 
		) then
			[ret_addr] = -1;
			goto return_to_user;
		endif;
    endif;

    //if no problems>>>Aquire>>>Delete>>>Release
    multipush(R1, R2, R3, R4, R5, R6, R7);
    R1 = 4;		//acquire inode
    R2 = R7;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7);

    //if file is open then return -2
    if([FILE_STATUS_TABLE + 4*R7 + 1] != -1) then
        multipush(R1, R2, R3, R4, R5, R6, R7);
        R1 = 5;  		//release inode
        R2 = R7;
        R3 = pid;
        call RESOURCE_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6, R7);

        [ret_addr] = -2;		//file is open
        goto return_to_user;
    endif;

    R8 = INODE_TABLE + 16*R7 + 8;
    R9 = 0;

    while(R9 < 4) do		//if block in buffer table then reset dirty bit
		if([R8 + R9] == -1) then	//checking
	        R9 = R9 + 1;
	        continue;
        endif;
        
		if([BUFFER_TABLE + 4*([R8 + R9]%4) + 0] == [R8 + R9]) then
			[BUFFER_TABLE + 4*([R8 + R9]%4) + 1] = 0;	
		endif;

		multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9);
        R1 = 4; 			//Release block
        R2 = [R8 + R9]; 		
        R3 = pid;
        call MEMORY_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9);

        [R8 + R9] = -1;
        R9 = R9 + 1;
    endwhile;

    R8 = INODE_TABLE + 16*R7;		//invalidate inode table
    R9 = 0;
    while(R9 < 5) do
        [R8 + R9] = -1;
        R9 = R9 + 1;
    endwhile;
    [R8 + 2] = 0;					//size is reset to 0 not -1

    R8 = ROOT_FILE + 8*R7;			//invalidate root table
    R9 = 0;
    while(R9 < 5) do
        [R8 + R9] = -1;
        R9 = R9 + 1;
    endwhile;

    multipush(R1, R2, R3, R4, R5, R6, R7, R8, R9);		//Release inode
    R1 = 5;  //Release inode
    R2 = R7;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6, R7, R8, R9);

    [ret_addr] = 0;
    goto return_to_user;
endif;


return_to_user:
    [PROCESS_TABLE + 16*pid + 9] = 0;
    SP = usp;
    ireturn;
